{
  "colors": {
    "background": "#ffffff",
    "ink": "#121212",
    "muted": "#707070",
    "line": "rgba(16,16,16,0.14)",
    "accent": "#ff3b00",
    "inverse-background": "#101010",
    "inverse-ink": "#ffffff"
  },
  "fonts": {
    "sans": {"family": "Instrument Sans", "weights": [400, 500, 600], "source": "../assets/fonts/"},
    "mono": {"family": "IBM Plex Mono", "weights": [500], "source": "../assets/fonts/"}
  },
  "layout": {
    "page-padding": "clamp(1.25rem, 4vw, 4rem)",
    "content-max": "none",
